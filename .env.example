# Password koneksi database.
DB_PASSWORD=

# Kunci untuk menandatangani cookie sesi.
SESSION_SECRET=

# Model yang digunakan.
OLLAMA_MODEL=qwen3:4b-instruct

# Mengaktifkan integrasi Google Places.
GOOGLE_PLACES_ENABLED=false

# Kunci API untuk Google Places.
GOOGLE_PLACES_API_KEY=

# URL halaman syarat dan ketentuan.
APP_TERMS_URL=

# URL halaman kebijakan privasi.
APP_PRIVACY_URL=

# Mode aplikasi, misalnya development atau production.
NODE_ENV=development

# Membatasi cookie sesi ke HTTPS jika true.
SESSION_COOKIE_SECURE=false

# Port server aplikasi.
PORT=3000

# Alamat server Ollama.
OLLAMA_URL=http://localhost:11434
