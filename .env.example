# Gunakan: salin ke .env, isi sendiri, lalu npm run start:env.
# File .env tidak ikut Git. Jangan kirim nilai rahasia ke chat.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bengkel
DB_SSL=false
SESSION_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
APP_TERMS_URL=
APP_PRIVACY_URL=

# Untuk akses HTTPS melalui reverse proxy lokal. Biarkan false untuk HTTP lokal.
SESSION_COOKIE_SECURE=false

# Aktifkan Geocoding API untuk nama kecamatan/kabupaten. Bisa memakai key server terpisah.
GOOGLE_GEOCODING_API_KEY=

# Key browser berbeda dari key server. Batasi referrer ke domain aplikasi.
GOOGLE_MAPS_BROWSER_KEY=

# Customer service memakai Gemini AI untuk memilih panduan, tanpa mengarang status/biaya.
CS_AI_USE_MODEL=true
