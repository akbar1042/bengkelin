{
  "name": "hackathon",
  "version": "1.0.0",
  "description": "",
  "main": "login.js",
  "scripts": {
    "start": "node login.js",
    "test": "node tests/triage.test.cjs && node tests/chat.test.cjs && node tests/workshops.test.cjs && node tests/hesitation.test.cjs && node scripts/audit-ai-data.cjs && node tests/workshop-ui.test.cjs && node tests/dashboards.test.cjs",
    "test:ai": "node tests/chat.integration.cjs",
    "train:ai": "node scripts/train-ai.cjs",
    "eval:ai": "node scripts/evaluate-ai.cjs",
    "eval:chat": "node scripts/evaluate-chat.cjs --all",
    "eval:dev": "node scripts/evaluate-v2.cjs --split dev --tag current --pipeline",
    "eval:test": "node scripts/evaluate-v2.cjs --dataset v3 --split test --tag current-v3 --pipeline",
    "migrate:partners": "node scripts/migrate-partners.cjs",
    "admin:grant": "node scripts/manage-admin.cjs grant",
    "admin:revoke": "node scripts/manage-admin.cjs revoke",
    "test:partners": "node --env-file-if-exists=.env tests/partners.integration.cjs",
    "start:env": "node --env-file=.env login.js",
    "audit:ai": "node scripts/audit-ai-data.cjs",
    "eval:v4": "node scripts/evaluate-v2.cjs --dataset v4 --split test --tag current-v4 --pipeline",
    "eval:v5": "node scripts/evaluate-v2.cjs --dataset v5 --split test --tag current-v5 --pipeline",
    "eval:v6": "node scripts/evaluate-v2.cjs --dataset v6 --split test --tag current-v6 --pipeline",
    "test:dashboards": "node --env-file-if-exists=.env tests/dashboards.integration.cjs",
    "migrate:features": "node --env-file-if-exists=.env scripts/migrate-features.cjs",
    "test:features": "node --env-file-if-exists=.env tests/features.integration.cjs",
    "migrate:commerce": "node --env-file-if-exists=.env scripts/migrate-commerce.cjs",
    "test:commerce": "node --env-file-if-exists=.env tests/commerce.integration.cjs",
    "test:support": "node --env-file-if-exists=.env tests/support-tickets.integration.cjs",
    "migrate:support": "node --env-file-if-exists=.env scripts/migrate-support.cjs",
    "migrate:audit": "node --env-file-if-exists=.env scripts/migrate-audit.cjs",
    "test:audit": "node --env-file-if-exists=.env tests/audit.integration.cjs",
    "test:six-fixes": "node --env-file-if-exists=.env tests/six-fixes.integration.cjs",
    "migrate:review-versions": "node --env-file-if-exists=.env scripts/migrate-review-versions.cjs",
    "test:four-fixes": "node --env-file-if-exists=.env tests/four-fixes.integration.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.5"
  }
}
